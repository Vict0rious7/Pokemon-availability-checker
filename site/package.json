{
  "name": "pokemon-availability-checker-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "finder": "tsx scripts/finder.ts ../data src/generated/finder.json",
    "lists": "NODE_OPTIONS=--max-old-space-size=6144 tsx ../engine/src/lists.ts ../data public/generated/lists.json 16",
    "listcheck": "tsx ../engine/src/listcheck.ts ../data public/generated/lists.json 12",
    "dev": "npm run finder && vite",
    "build": "npm run finder && npm run lists && npm run listcheck && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
